ZARINPAL_MERCHANT_ID=your-zarinpal-merchant-id
ZARINPAL_SANDBOX=false
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional SMS.ir settings used by the login and registration flow.
SMS_IR_API_KEY=your-sms-ir-api-key
SMS_IR_TEMPLATE_ID=323089
SMS_IR_TEMPLATE_PARAMETER=Code

# Digikala Seller Open API (server-side only; never expose in browser or git history)
DIGIKALA_BASE_URL=https://seller.digikala.com
DIGIKALA_SANDBOX=true
DIGIKALA_CLIENT_CODE=your-digikala-client-code
DIGIKALA_CLIENT_ID=your-digikala-client-id
DIGIKALA_CLIENT_SECRET=your-digikala-client-secret
# Prefer a server file path instead of storing the PEM in the repo or .env file.
DIGIKALA_PRIVATE_KEY_PATH=/etc/korooshkala/keys/digikala-private.pem
# or set DIGIKALA_PRIVATE_KEY only in the server environment if a file path is not available.
DIGIKALA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----"
DIGIKALA_ACCESS_TOKEN=server-only-access-token
DIGIKALA_REFRESH_TOKEN=server-only-refresh-token